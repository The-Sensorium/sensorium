# Required. Both are public; the browser holds only the anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional.
VITE_KLIPY_APP_KEY=
VITE_KLIPY_ENDPOINT=
VITE_GEOCODING_ENDPOINT=

# Optional. Cloudflare Turnstile site key for Supabase Auth bot protection.
# Empty locally (widget hidden, auth works without captcha).
# Set per environment in Vercel: staging key on preview, prod key on production.
VITE_TURNSTILE_SITE_KEY=
