{
  "expo": {
    "name": "Sensorium",
    "slug": "sensorium",
    "version": "0.0.12",
    "orientation": "portrait",
    "scheme": "sensorium",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon-light.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "online.thesensorium.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used for video during cluster calls.",
        "NSMicrophoneUsageDescription": "Microphone is used for audio during cluster calls."
      },
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon-dark.png"
      }
    },
    "android": {
      "icon": "./assets/legacy-icon-light.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#fef8f7"
      },
      "package": "online.thesensorium.app",
      "versionCode": 12,
      "googleServicesFile": "./google-services.json",
      // Pan (not resize): react-native-keyboard-controller manages keyboard
      // insets itself (its example app uses adjustPan). With resize the
      // system shrinks the layout AND the library applies its own
      // inset/translate on top, overshooting the sticky composer and
      // flashing blank list space during keyboard transitions.
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "NOTIFICATIONS",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification_icon.png",
          "color": "#fff8f6"
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fef8f7",
          "image": "./assets/splash-blank.png",
          "dark": {
            "backgroundColor": "#181818",
            "image": "./assets/splash-blank.png"
          },
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d4d0da4-bebb-4743-96a9-7ec49ddcdf7b"
      }
    },
    "owner": "emathew"
  }
}
